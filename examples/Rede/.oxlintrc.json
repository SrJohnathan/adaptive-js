{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-debugger": "error",
    "no-var": "warn",
    "typescript/no-unused-vars": "warn",
    "typescript/no-explicit-any": "off",
    "import/no-duplicates": "warn"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.adaptivejs/**"
  ]
}