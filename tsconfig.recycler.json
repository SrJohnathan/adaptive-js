{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist-test",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": false,
    "noEmitOnError": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "@adaptive-js/web",
    "noEmit": false
  },
  "include": [
    "tests/recycler-view.test.ts",
    "extension/components/src/recycler-view.tsx"
  ]
}
